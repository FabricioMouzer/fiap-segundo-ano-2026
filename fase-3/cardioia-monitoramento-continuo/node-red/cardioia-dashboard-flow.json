    "func": "const d = msg.payload || {};\nmsg.payload = `Dispositivo: ${d.state || 'desconhecido'} | Fila: ${d.buffer_pending || 0} | Descartadas: ${d.dropped_samples || 0}`;\nreturn msg;",
