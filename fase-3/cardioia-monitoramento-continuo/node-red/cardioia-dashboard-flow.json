  {
    "id": "mqtt_telemetry",
    "type": "mqtt in",
    "z": "flow_cardioia",
    "name": "Telemetria CardioIA",
    "topic": "cardioia/fase3/cardioia-esp32-01/telemetria",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 120,
    "wires": [["json_telemetry"]]
  },
  {
    "id": "json_telemetry",
    "type": "json",
    "z": "flow_cardioia",
    "name": "JSON → objeto",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 350,
    "y": 120,
    "wires": [["normalize_telemetry"]]
  },
  {
    "id": "normalize_telemetry",
    "type": "function",
    "z": "flow_cardioia",
    "name": "Validar e separar sinais",
    "func": "const d = msg.payload || {};\nconst required = ['bpm', 'temperature_c', 'alert', 'buffer_pending'];\nif (!required.every((key) => Object.prototype.hasOwnProperty.call(d, key))) {\n    node.warn('Payload descartado: campos obrigatórios ausentes');\n    return [null, null, null, null];\n}\nconst bpm = Number(d.bpm);\nconst temperature = Number(d.temperature_c);\nif (!Number.isFinite(bpm) || !Number.isFinite(temperature)) {\n    node.warn('Payload descartado: valor numérico inválido');\n    return [null, null, null, null];\n}\nconst bpmMsg = { topic: 'BPM', payload: bpm };\nconst tempMsg = { topic: 'Temperatura', payload: temperature };\nconst isAlert = String(d.alert) !== 'normal';\nconst alertMsg = {\n    payload: isAlert ? `ALERTA: ${d.alert}` : 'NORMAL',\n    color: isAlert ? '#b91c1c' : '#15803d'\n};\nconst statusMsg = {\n    payload: `Origem: ${d.source} | Fila: ${d.buffer_pending} | Descartadas: ${d.dropped_samples || 0} | Seq: ${d.sequence}`\n};\nreturn [bpmMsg, tempMsg, alertMsg, statusMsg];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 575,
    "y": 120,
    "wires": [["chart_bpm"], ["gauge_temp"], ["template_alert"], ["text_status"]]
  },
  {
    "id": "chart_bpm",
    "type": "ui_chart",
    "z": "flow_cardioia",
    "name": "BPM em tempo real",
    "group": "group_vitals",
    "order": 1,
    "width": 12,
    "height": 5,
    "label": "Batimentos cardíacos simulados",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Aguardando telemetria",
    "dot": false,
    "ymin": "40",
    "ymax": "180",
    "removeOlder": "1",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#e11d48", "#2563eb", "#16a34a"],
    "outputs": 1,
