/**
 * PROJETO: CardioIA - Monitoramento IoT de Sinais Vitais (Fase 3)
 * DISPOSITIVO: ESP32 (Simulador Wokwi)
 * DESCRIÇÃO: Coleta contínua de temperatura (DHT22) e frequência cardíaca (Pushbutton),
 *            com aplicação de trava fisiológica, armazenamento offline em buffer circular
 *            (Edge Computing) e transmissão de telemetria via protocolo MQTT.
 */

#include <WiFi.h>
#include <PubSubClient.h>
#include <DHTesp.h>

// ============================================================================
// 1. CONFIGURAÇÕES DE REDE WI-FI E BROKER MQTT
// ============================================================================
const char* ssid = "Wokwi-GUEST";           // Rede Wi-Fi virtual padrão do simulador Wokwi
const char* password = "";                  // Rede aberta (sem senha)
const char* mqtt_server = "broker.hivemq.com"; // Broker público HiveMQ para camada Fog/Cloud

WiFiClient espClient;                       // Cliente TCP/IP base para uso da pilha Wi-Fi
PubSubClient client(espClient);             // Instância do cliente MQTT associada ao Wi-Fi

// ============================================================================
// 2. MAPEAMENTO DE HARDWARE E VARIÁVEIS FISIOLÓGICAS
// ============================================================================
const int DHT_PIN = 15;                     // Pino GPIO 15 conectado ao barramento de dados do DHT22
const int BUTTON_PIN = 4;                   // Pino GPIO 4 conectado ao botão de pulso cardíaco
DHTesp dhtSensor;                           // Objeto de controle do sensor térmico

// A qualificação 'volatile' garante que a variável não seja otimizada pelo compilador,
// pois seu valor é modificado de forma assíncrona dentro de uma interrupção de hardware.
volatile int beatCount = 0;                 
unsigned long lastBpmCalc = 0;              // Marca temporal da última janela de amostragem (ms)
int currentBPM = 0;                         // Valor consolidado dos batimentos por minuto

// ============================================================================
// 3. ESTRUTURAS DE EDGE COMPUTING E RESILIÊNCIA OFFLINE
// ============================================================================
bool wifiSimuladoConectado = true;          // Flag de controle para injeção de falha de rede via Serial
const int BUFFER_SIZE = 20;                 // Capacidade máxima de retenção local na memória RAM

// Estrutura de dados homogênea para empacotar leituras retidas na borda (Edge)
struct Dado {
  float temp;
  int bpm;
};

Dado buffer[BUFFER_SIZE];                   // Array estático atuando como fila de armazenamento local
int bufferIndex = 0;                        // Ponteiro indicador da posição atual do buffer

// ============================================================================
// 4. ROTINA DE SERVIÇO DE INTERRUPÇÃO (ISR)
// ============================================================================
// O atributo IRAM_ATTR aloca a função diretamente na memória RAM interna do ESP32,
// garantindo execução imediata a cada clique físico sem atrasos de leitura de memória Flash.
void IRAM_ATTR countBeat() {
  beatCount++;
}

// ============================================================================
// 5. INICIALIZAÇÃO DO SISTEMA (SETUP)
// ============================================================================
void setup() {
  Serial.begin(115200);                     // Inicializa comunicação serial para telemetria e debug
  
  // Configuração dos periféricos de entrada
  dhtSensor.setup(DHT_PIN, DHTesp::DHT22);  // Define o modelo do sensor térmico no pino 15
  pinMode(BUTTON_PIN, INPUT_PULLUP);        // Ativa resistor de pull-up interno para evitar flutuação elétrica
  
  // Associa o pino do botão à interrupção na borda de descida (FALLING: transição de 3.3V para GND)
  attachInterrupt(digitalPinToInterrupt(BUTTON_PIN), countBeat, FALLING);

  // Inicialização da conectividade sem fio
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }
  Serial.println("Wi-Fi base do simulador conectado.");
  
  // Aponta o cliente MQTT para o broker HiveMQ na porta TCP padrão não criptografada (1883)
  client.setServer(mqtt_server, 1883); 
}

// ============================================================================
// 6. LAÇO PRINCIPAL DE EXECUÇÃO CONTÍNUA (LOOP)
// ============================================================================
void loop() {
  // 6.1. Injeção de Falhas para Teste de Resiliência (Comandos via Monitor Serial)
  if (Serial.available() > 0) {
    char cmd = Serial.read();
    if (cmd == '0') { 
      wifiSimuladoConectado = false; 
      Serial.println("--- Wi-Fi SIMULADO CAIU ---"); 
    }
    if (cmd == '1') { 
      wifiSimuladoConectado = true; 
      Serial.println("--- Wi-Fi SIMULADO RESTAURADO ---"); 
    }
  }

  // 6.2. Janela de Amostragem Não-Bloqueante (Executa a cada 5000 milissegundos)
  if (millis() - lastBpmCalc > 5000) {
    
    // Modelagem Fisiológica:
    // Define frequência basal de repouso em 75 BPM. Cada pulso na janela de 5s soma 12 BPM.
    currentBPM = 75 + (beatCount * 12);
    
    // Trava Biológica (Clamp):
    // Restringe o teto máximo a 220 BPM, prevenindo valores espúrios de ruído mecânico (bounce).
    if (currentBPM > 220) {
      currentBPM = 220;
    }
    
    // Reinicia os acumuladores para o próximo ciclo de 5 segundos
    beatCount = 0; 
    lastBpmCalc = millis();

    // Coleta a temperatura atual a partir do sensor DHT22
    float temp = dhtSensor.getTemperature();

    // 6.3. Roteamento de Dados: Transmissão em Nuvem (Online) vs Retenção na Borda (Offline)
    if (wifiSimuladoConectado) {
      
      // Verifica a sessão MQTT e reconecta automaticamente utilizando um ID hexadecimal único
      if (!client.connected()) {
        String clientId = "CardioIA-ESP32-" + String(random(0xffff), HEX);
        client.connect(clientId.c_str());
      }
      client.loop(); // Mantém o processamento de pacotes de controle MQTT (Keep-Alive)

      // Esvaziamento do Buffer (Sincronização de Dados Represados):
      // Caso existam leituras salvas durante uma queda de conexão anterior, transmite todas antes do dado atual
      while(bufferIndex > 0) {
        bufferIndex--;
        String payload = "{\"temp\":" + String(buffer[bufferIndex].temp) + 
                         ", \"bpm\":" + String(buffer[bufferIndex].bpm) + 
                         ", \"status\":\"recuperado\"}";
        client.publish("cardioia/sinais", payload.c_str());
        Serial.println("Sincronizando atrasado: " + payload);
      }

      // Publicação da Leitura Atual em Tempo Real
      String payload = "{\"temp\":" + String(temp) + 
                       ", \"bpm\":" + String(currentBPM) + 
                       ", \"status\":\"online\"}";
      client.publish("cardioia/sinais", payload.c_str());
      Serial.println("Enviado: " + payload);

    } else {
      // Operação em Modo Offline (Edge Computing):
      // Guarda a leitura na memória RAM local caso ainda haja espaço disponível no buffer estático
      if (bufferIndex < BUFFER_SIZE) {
        buffer[bufferIndex].temp = temp;
        buffer[bufferIndex].bpm = currentBPM;
        bufferIndex++;
        Serial.println("Offline. Salvo localmente -> Temp: " + String(temp) + " | BPM: " + String(currentBPM));
      }
    }
  }
}