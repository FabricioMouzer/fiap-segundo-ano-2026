  {
    "id": "f5a0000000000020",
    "type": "function",
    "z": "f5a0000000000001",
    "name": "Validar e distribuir telemetria",
    "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (error) {\n        return [null, null, null, null, null, null, null, { payload: 'JSON inválido: ' + error.message, original: msg.payload }];\n    }\n}\nconst required = ['schema_version','device_id','sequence','captured_uptime_ms','temperature_c','humidity_pct','bpm','sensor_valid','alert_code','alert','source','buffer_pending','dropped_samples'];\nconst missing = required.filter((key) => !Object.prototype.hasOwnProperty.call(p || {}, key));\nif (!p || typeof p !== 'object' || missing.length) {\n    return [null, null, null, null, null, null, null, { payload: 'Campos ausentes: ' + missing.join(', '), original: msg.payload }];\n}\nif (p.schema_version !== 1 || p.device_id !== 'cardioia-esp32-01') {\n    return [null, null, null, null, null, null, null, { payload: 'Contrato incompatível', schema_version: p.schema_version, device_id: p.device_id }];\n}\nif (![p.sequence,p.captured_uptime_ms,p.temperature_c,p.humidity_pct,p.bpm,p.alert_code,p.buffer_pending,p.dropped_samples].every(Number.isFinite) || typeof p.sensor_valid !== 'boolean') {\n    return [null, null, null, null, null, null, null, { payload: 'Tipos inválidos', original: p }];\n}\nconst allowedAlerts = new Set(['normal','low_bpm','high_bpm','high_temperature','sensor_error']);\nconst allowedSources = new Set(['live','buffered']);\nif (!allowedAlerts.has(p.alert) || !allowedSources.has(p.source)) {\n    return [null, null, null, null, null, null, null, { payload: 'Enumeração inválida', alert: p.alert, source: p.source }];\n}\nconst labels = [];\nif (!p.sensor_valid || (p.alert_code & 8)) labels.push('FALHA DO SENSOR');\nif (p.alert_code & 4) labels.push('TEMPERATURA ALTA');\nif (p.alert_code & 2) labels.push('BPM ALTO');\nif (p.alert_code & 1) labels.push('BPM BAIXO');\nconst isAlert = labels.length > 0;\nconst status = isAlert ? labels.join(' + ') : 'NORMAL';\nconst color = isAlert ? '#b42318' : '#067647';\nconst common = { sequence: p.sequence, source: p.source, synthetic: true };\nreturn [\n    { payload: p.bpm, topic: 'BPM', ...common },\n    { payload: p.temperature_c, ...common },\n    { payload: p.humidity_pct, ...common },\n    { payload: status, ui_update: { color, fontSize: '22px' }, ...common },\n    { payload: '#' + p.sequence, ...common },\n    { payload: p.source + ' | fila: ' + p.buffer_pending + ' | descartes: ' + p.dropped_samples, ...common },\n    { payload: 'online (telemetria ativa) | fila: ' + p.buffer_pending + ' | descartes: ' + p.dropped_samples, ui_update: { color: '#067647', fontSize: '18px' }, ...common },\n    null\n];",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 100,
    "wires": [
      ["f5a0000000000030"],
      ["f5a0000000000031"],
      ["f5a0000000000032"],
      ["f5a0000000000033"],
      ["f5a0000000000034"],
      ["f5a0000000000035"],
      ["f5a0000000000036", "f5a0000000000052"],
      ["f5a0000000000050"]
    ]
  },
  {
    "id": "f5a0000000000021",
    "type": "function",
    "z": "f5a0000000000001",
    "name": "Formatar status do dispositivo",
    "func": "let p = msg.payload;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { return null; } }\nif (!p || p.schema_version !== 1 || typeof p.state !== 'string') return null;\nconst online = p.state === 'online' || p.state === 'online_syncing';\nconst labels = { online: 'online', online_syncing: 'online — sincronizando', offline_unexpected: 'offline — inicie o Wokwi' };\nconst displayState = labels[p.state] || p.state;\nmsg.payload = displayState + ' | fila: ' + p.buffer_pending + ' | descartes: ' + p.dropped_samples;\nmsg.ui_update = { color: online ? '#067647' : '#b42318', fontSize: '18px' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 220,
    "wires": [["f5a0000000000036", "f5a0000000000052"]]
  },
